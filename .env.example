# Where analytics events are stored: "file", "remote" or "none".
# Default: "file" in development, "none" in production (see docs/architecture.md).
ANALYTICS_STORE=

# Only used by the "file" store. Default: .data/events.ndjson
ANALYTICS_FILE=

# Only used by the "remote" store: send events to the collector instead of
# keeping them here. See docs/architecture.md, "Open decision: production storage".
COLLECTOR_URL=
COLLECTOR_KEY=

# Secret that gates /stats. Without it, /stats is open in development and 404 in production.
STATS_TOKEN=

# Secret mixed into the daily visitor hash. Long and random.
VISITOR_SALT=
